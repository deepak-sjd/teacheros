# Copy this file to .env and fill in real values for local development.
# NEVER commit the actual .env file - it is already in .gitignore.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/teacheros
DB_USERNAME=teacheros
DB_PASSWORD=teacheros

# --- JWT ---
# Generate a real random 32+ character secret for anything beyond local dev,
# e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- OTP delivery ---
# "log" prints the OTP to the application log (safe for local dev/pilot).
# Set to a real provider mode once an SMS/WhatsApp integration exists.
OTP_DELIVERY_MODE=log
OTP_TTL_MINUTES=5

# --- Server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
