# Copy this file to .env and fill in real values for local development.
# NEVER commit the actual .env file - it is already in .gitignore.
#
# PRODUCTION (SPRING_PROFILES_ACTIVE=prod): the app refuses to start unless the
# values marked [PROD REQUIRED] below are real. Nothing here may be left at its dev default.

# --- Database --- [PROD REQUIRED: all three, password must not be 'teacheros']
DB_URL=jdbc:postgresql://localhost:5432/teacheros
DB_USERNAME=teacheros
DB_PASSWORD=teacheros

# --- JWT --- [PROD REQUIRED: JWT_SECRET, 32+ chars, not the dev default]
# Generate a real random secret for anything beyond local dev,
# e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- CORS --- [PROD REQUIRED: exact web origin(s), comma-separated, never '*']
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OTP delivery --- [PROD REQUIRED: sms]
# "log" prints the OTP to the application log (local dev only).
OTP_DELIVERY_MODE=log
OTP_TTL_MINUTES=5

# --- OTP rate limiting (defaults shown) ---
# AUTH: 5 code requests per phone / 20 per IP per window; 5 wrong codes locks the phone.
# These are read from app.security.otp.* - override in application.yml if needed.

# --- SMS (Twilio) --- [PROD REQUIRED when OTP_DELIVERY_MODE=sms]
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments --- [PROD REQUIRED: PAYMENT_PROVIDER=razorpay + both keys]
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Object storage --- [PROD REQUIRED: not the MinIO dev credentials]
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=teacheros
STORAGE_SECRET_KEY=teacheros123
STORAGE_BUCKET=teacheros-study-material

# --- Server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Behind a reverse proxy/load balancer, also set SERVER_FORWARD_HEADERS_STRATEGY=native
# so the OTP per-IP limit sees the real client IP instead of the proxy's.
